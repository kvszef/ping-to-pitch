# Nach .env kopieren und ausfüllen. .env wird nicht eingecheckt.

# Privater Schlüssel aus dem Vapi-Dashboard unter Settings → API Keys.
VAPI_API_KEY=

# Öffentliche https-URL dieses Dienstes, ohne Schrägstrich am Ende.
# Kommt von `cloudflared tunnel --url http://localhost:3100` und ändert sich bei jedem Start.
# Nach jeder Änderung `npm run setup` erneut ausführen.
PUBLIC_URL=

PORT=3100

# Sprache der Erkennung (Deepgram-Sprachcode).
LANGUAGE=de

# Ansage beim Abheben, damit der Anrufer hört, dass die Leitung steht.
# Leer lassen, wenn der Assistent von der ersten Sekunde an schweigen soll.
GREETING=Die Leitung steht und wird mitgeschrieben.


# ---------- Bruecke (npm run bridge) ----------
# Nur noetig, wenn der Berater im Gespraech mitreden soll. Der Kunde ruft die Nummer an,
# der Anbieter verbindet ihn mit dem Handy des Beraters, und der Audiostrom beider Seiten
# laeuft parallel zu ElevenLabs. Eigener Prozess, eigener Port, eigener Tunnel.
#
# Anbieter: SignalWire oder Twilio – beide sprechen dasselbe cXML/TwiML, der Code ist
# derselbe. Zugangsdaten braucht die Bruecke keine: die Answer-URL wird bei der Nummer
# im Dashboard des Anbieters hinterlegt, alles andere laeuft ueber diesen Webhook.

# Zugangsdaten aus dem Twilio-Dashboard (Startseite). Nur `npm run twilio` benutzt sie,
# um die Nummer zu kaufen und den Voice-Webhook zu setzen. Die Bruecke selbst braucht sie nicht.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Land der zu kaufenden Nummer. US braucht kein Regulatory Bundle und ist sofort da.
TWILIO_NUMBER_COUNTRY=US

# Alternativ SignalWire (`npm run signalwire`). Space ist die nackte Domain aus der
# Adresszeile nach dem Login, Project ID und Token stehen im Dashboard unter API.
SIGNALWIRE_SPACE=
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_NUMBER_COUNTRY=US

# Das Handy des Beraters in E.164. Im Trial muss diese Nummer als verifizierte Nummer
# eingetragen sein, sonst lehnt der Anbieter das ausgehende Bein ab. Die Nummer, mit der
# du dich bei Twilio registriert hast, ist automatisch verifiziert.
ADVISOR_NUMBER=

# Schluessel aus https://elevenlabs.io – transkribiert beide Gespraechsspuren.
ELEVENLABS_API_KEY=

BRIDGE_PORT=3200
# Zweiter Tunnel: `cloudflared tunnel --url http://localhost:3200`.
# Diese URL gehoert bei Plivo als Answer-URL der Nummer hinterlegt (mit /answer am Ende).
BRIDGE_PUBLIC_URL=


# ---------- Copilot ----------

# Key aus https://console.anthropic.com/ (alternativ `ant auth login`, dann leer lassen).
ANTHROPIC_API_KEY=
MODEL=claude-opus-5
# low | medium | high | xhigh | max -- low hält die Live-Hinweise schnell.
EFFORT=low
MAX_TOKENS=800
# 1 = ohne Modell arbeiten (feste Antworten), für Oberflächen- und Durchstichtests.
MOCK_BRAIN=0

# MCP Toolbox: läuft lokal mit `npm run toolbox`, gestartet aus toolbox/tools.yaml.
TOOLBOX_URL=http://127.0.0.1:5000
TOOLBOX_TOOLSET=call_copilot

# Daten. Die Case-Dateien werden nur gelesen, unrisk.db baut `npm run load-data`.
UNRISK_DB=./data/unrisk.db
CLIENTS_JSON=../core-case/portfolio-data/clients.json
REFERENCE_JSON=../core-case/portfolio-data/reference.json
# Anrufernummer -> Kundennummer, z. B. {"+41791234567": "CASE-004"}.
# Die Case-Daten enthalten keine Telefonnummern, diese Zuordnung ist bewusst gemockt.
CALLERS_JSON=./data/callers.json

# Kunde, der bei unbekannter Nummer vorausgewählt wird (leer = Oberfläche fragt nach).
DEFAULT_CLIENT_REF=
# Standardland für die Umrechnung auf E.164.
DEFAULT_COUNTRY=+41
