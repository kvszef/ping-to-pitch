# Nach .env.local kopieren und ausfüllen. .env.local wird nicht eingecheckt.
# Die Schlüssel bleiben im Vite-Server und erreichen den Browser nie.

OPENAI_API_KEY=
# Modell für Briefing und Berater-Chat
OPENAI_MODEL=gpt-4o-mini
# Schnelles Modell für die Auswertung während des Gesprächs
OPENAI_MODEL_FAST=gpt-4o-mini

# Apertus über eine OpenAI-kompatible Schnittstelle (Basis-URL endet auf /v1)
APERTUS_BASE_URL=
APERTUS_API_KEY=
APERTUS_MODEL=

ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
