# Nach .env.local kopieren und ausfüllen. .env.local wird nicht eingecheckt.
# Die Schlüssel bleiben im Vite-Server und erreichen den Browser nie.

OPENAI_API_KEY=
# Modell für Briefing und Berater-Chat
OPENAI_MODEL=gpt-4o
# Schnelles Modell für die Auswertung während des Gesprächs
OPENAI_MODEL_FAST=gpt-4o-mini

# Apertus über eine OpenAI-kompatible Schnittstelle (Basis-URL endet auf /v1)
APERTUS_BASE_URL=
APERTUS_API_KEY=
APERTUS_MODEL=

ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# Kundendaten: SQLite über MCP Toolbox, dieselbe Datenbank wie der Telefon-Copilot.
#   cd phone && npm run load-data   Datenbank aus den Case-Dateien bauen
#   cd phone && npm run toolbox     Dienst davor starten
# Antwortet die Toolbox nicht, liest die App die Case-Dateien und sagt es im Serverlog;
# DATA_SOURCE=dateien überspringt die Datenbank von vornherein.
TOOLBOX_URL=http://127.0.0.1:5000
DATA_SOURCE=toolbox

# Fixed language of the call transcription: de or en. Unset: the advisor's display language, else English.
# Set it to de for a German call while the screen is in English.
# TRANSCRIBE_LANGUAGE=de

# Optional: audio relay for the internet call (TURN), for networks that block the direct link between phone
# and laptop. Cloudflare dashboard > Realtime > TURN Server > Create gives both values. Without them the
# call uses the direct link only.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Optional: a stronger model for the live call agent only (default: OPENAI_MODEL_FAST)
OPENAI_MODEL_AGENT=
