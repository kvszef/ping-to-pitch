# START Hack case material (UNRISKOMEGA AG): not ours, so never committed. scripts/case-data.mjs downloads
# it from github.com/START-Hack/unriskomega-2026 at a pinned commit on `npm ci`. Our demo clients live in
# demo-clients/; files dropped into core-case/portfolio-data/new-clients/ stay local.
/core-case/
/side-challenge/
/assets/

# Secrets and machine-local config. API keys live in app/.env.local and never get committed.
.env
.env.*
!.env.example
*.local

# Dependencies and build output
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Runtime data we generate (call memory, imported statements). Seed it from code, not from a committed file.
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Personal agent settings
.claude/settings.local.json
CLAUDE.local.md

# Claude Code agent worktrees (machine-local)
.claude/worktrees/
