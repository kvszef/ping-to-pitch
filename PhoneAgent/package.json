{
  "name": "phone-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Telefon-Agent: Twilio ConversationRelay + Claude, spricht mit Kunden über ihre Portfoliodaten",
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "up": "node --env-file-if-exists=.env --import tsx scripts/up.ts",
    "tunnel": "node --env-file-if-exists=.env --import tsx scripts/up.ts --no-server",
    "webhook": "node --env-file-if-exists=.env --import tsx scripts/set-webhook.ts",
    "numbers": "node --env-file-if-exists=.env --import tsx scripts/buy-number.ts",
    "call": "node --env-file-if-exists=.env --import tsx scripts/simulate-call.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "twilio": "^6.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
