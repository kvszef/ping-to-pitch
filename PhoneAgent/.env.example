# ---------- Claude ----------
# API-Key aus https://console.anthropic.com/ (alternativ: `ant auth login`, dann leer lassen)
ANTHROPIC_API_KEY=
MODEL=claude-opus-5
# low | medium | high  (low = schnellste Antworten am Telefon)
EFFORT=low
MAX_TOKENS=1024
# 1 = ohne Claude testen (kanned Antworten), z. B. für den WebSocket-/Twilio-Durchstich
MOCK_LLM=0

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Die gekaufte Nummer in E.164, z. B. +41715000000
TWILIO_PHONE_NUMBER=
# Nur zum KAUF einer Schweizer Nummer nötig (Regulatory Bundle + Adresse, siehe README)
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=
# 0 = Twilio-Signaturprüfung am /twiml-Webhook abschalten (nur lokal/Debug)
TWILIO_VALIDATE=1

# ---------- Server ----------
PORT=3000
# Öffentliche https-URL dieses Servers (Tunnel). `npm run up` setzt sie automatisch.
PUBLIC_URL=

# ---------- Sprache & Stimme (Twilio ConversationRelay) ----------
CALL_LANGUAGE=de-DE
# Optional: Erkennung auf Schweizerdeutsch-Locale umstellen (Google STT), Ausgabe bleibt de-DE
TRANSCRIPTION_LANGUAGE=
TTS_LANGUAGE=
# Optional: Google | Amazon | ElevenLabs  (leer = Twilio-Standard für die Sprache)
TTS_PROVIDER=
TTS_VOICE=
# Optional: Google | Deepgram
TRANSCRIPTION_PROVIDER=
SPEECH_MODEL=
# Begrüssung, wenn der Anrufer unbekannt ist / bekannt ist ({name} wird ersetzt)
WELCOME_GREETING=Grüezi und willkommen bei Ihrer Kundenberatung. Ich bin der digitale Assistent. Mit wem spreche ich?
WELCOME_GREETING_KNOWN=Grüezi {name}, willkommen bei Ihrer Kundenberatung. Ich bin der digitale Assistent. Wie kann ich Ihnen helfen?

# ---------- Daten ----------
# Kunde, der ohne Identifikation vorausgewählt ist (leer = Agent fragt nach dem Namen)
DEFAULT_CLIENT_REF=
# Pfade relativ zum Ordner PhoneAgent; mehrere clients-Dateien mit Komma trennen
CLIENTS_JSON=../core-case/portfolio-data/clients.json
REFERENCE_JSON=../core-case/portfolio-data/reference.json
CALLERS_JSON=callers.json
