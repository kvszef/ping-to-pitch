{
  "name": "phone-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Live-Call-Copilot: erkennt den Anrufer, holt die Kundendaten ueber MCP Toolbox und hilft dem Berater waehrend des Gespraechs",
  "type": "module",
  "engines": { "node": ">=22.9" },
  "workspaces": ["web"],
  "scripts": {
    "setup": "npm install && npm run toolbox:get && npm run load-data",
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:watch": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "web": "npm run dev --workspace web",
    "toolbox:get": "node --import tsx scripts/get-toolbox.ts",
    "toolbox": "node --env-file-if-exists=.env --import tsx scripts/run-toolbox.ts",
    "load-data": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --import tsx scripts/load-data.ts",
    "simulate": "node --env-file-if-exists=.env --import tsx scripts/simulate-call.ts",
    "simulate:audio": "node --env-file-if-exists=.env --import tsx scripts/simulate-audio.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@toolbox-sdk/core": "^1.2.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0"
  }
}
