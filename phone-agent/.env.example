# Kopieren nach .env und ausfuellen. Nichts davon gehoert ins Git.

# ---------- Claude ----------
# Key aus https://console.anthropic.com/ (alternativ `ant auth login`, dann leer lassen)
ANTHROPIC_API_KEY=
MODEL=claude-opus-5
# low | medium | high | xhigh | max  -- low haelt die Live-Hinweise schnell
EFFORT=low
MAX_TOKENS=800
# 1 = ohne Modell arbeiten (feste Antworten), fuer UI- und Durchstichtests
MOCK_BRAIN=0

# ---------- Spracherkennung ----------
# elevenlabs | openai | deepgram | mock
STT_PROVIDER=mock
STT_LANGUAGE=de
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-live-transcribe
# Optional: Deepgram Nova-3 (200 USD Startguthaben, ohne Kreditkarte)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ---------- Telefonie ----------
# sim      Fixture statt Telefon, laeuft ohne Netz und ohne Konto
# livekit  Referenzimplementierung (Browser betritt einen Raum)
# twilio   Fallback (Browser als Twilio-Client)
# external Die Nummer wird woanders betrieben und schickt Ereignisse an POST /call
TELEPHONY=sim
# Gemeinsames Geheimnis fuer POST /call, wenn TELEPHONY=external
INBOUND_TOKEN=

# LiveKit (nur bei TELEPHONY=livekit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=advisor-line

# Twilio (nur bei TELEPHONY=twilio; auf einem Trial-Konto fehlen <Stream> und <Dial>)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TWIML_APP_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
PUBLIC_URL=

# ---------- MCP Toolbox und Daten ----------
TOOLBOX_URL=http://127.0.0.1:5000
TOOLBOX_TOOLSET=call_copilot
UNRISK_DB=./data/unrisk.db
CLIENTS_JSON=../core-case/portfolio-data/clients.json
REFERENCE_JSON=../core-case/portfolio-data/reference.json
CALLERS_JSON=./data/callers.json
# Kunde, der bei unbekannter Nummer vorausgewaehlt wird (leer = Oberflaeche fragt)
DEFAULT_CLIENT_REF=

# ---------- Server ----------
PORT=4000
# Standardland fuer die Umrechnung auf E.164
DEFAULT_COUNTRY=+41
